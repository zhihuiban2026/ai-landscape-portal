<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 智慧景觀設計 — 東海大學光點計畫</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f4f3ef;
  --card:#ffffff;
  --text:#1c1c1c;
  --muted:#7a7a7a;
  --accent:#3a5a40;
  --accent-bg:#eef3ee;
  --border:#e2ded7;
  --radius:12px;
}
body{font-family:'Noto Sans TC',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}

/* ── Header ── */
header{
  padding:80px 48px 64px;
  text-align:center;
  background:linear-gradient(160deg,#f0eeea 0%,#f4f3ef 60%);
  border-bottom:1px solid var(--border);
  position:relative;overflow:hidden;
}
header::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(58,90,64,.07) 0%,transparent 70%);
  pointer-events:none;
}
.eyebrow{
  display:inline-block;
  font-size:.72rem;letter-spacing:.35em;
  color:var(--accent);text-transform:uppercase;font-weight:500;
  margin-bottom:20px;
  padding:5px 16px;border:1px solid rgba(58,90,64,.3);border-radius:100px;
  background:rgba(58,90,64,.05);
}
h1{
  font-family:'Noto Serif TC',serif;
  font-size:clamp(2rem,5vw,3.4rem);
  font-weight:300;letter-spacing:.06em;line-height:1.25;
  color:var(--text);margin-bottom:18px;
}
.header-sub{
  font-size:.92rem;color:var(--muted);font-weight:300;
  line-height:1.8;max-width:520px;margin:0 auto;
}
.divider{
  width:40px;height:1px;background:var(--accent);
  margin:24px auto;opacity:.4;
}

/* ── Main ── */
main{max-width:1200px;margin:0 auto;padding:64px 40px 100px}
.section-label{
  font-size:.72rem;letter-spacing:.22em;color:var(--muted);
  text-transform:uppercase;margin-bottom:36px;
}

/* ── Cards ── */
.cards{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:22px;
}
.card:nth-child(1){grid-column:1/3}
.card:nth-child(2){grid-column:3/5}
.card:nth-child(3){grid-column:5/7}
.card:nth-child(4){grid-column:2/4}
.card:nth-child(5){grid-column:4/6}
.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:32px;
  display:flex;flex-direction:column;
  transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease;
}
.card:hover{
  transform:translateY(-5px);
  box-shadow:0 12px 40px rgba(0,0,0,.1);
  border-color:#ccc8c0;
}
.card-num{
  font-size:.68rem;letter-spacing:.15em;color:var(--muted);
  margin-bottom:14px;font-weight:400;
}
.card-project{
  font-family:'Noto Serif TC',serif;
  font-size:1.3rem;font-weight:400;
  line-height:1.35;margin-bottom:6px;
}
.card-name{
  font-size:.8rem;color:var(--muted);font-weight:400;
  margin-bottom:18px;padding-bottom:18px;
  border-bottom:1px solid var(--border);
}
.card-desc{
  font-size:.88rem;color:var(--muted);
  line-height:1.8;flex:1;font-weight:300;
}
.card-desc.placeholder{font-style:italic;opacity:.7}
.card-actions{display:flex;gap:10px;margin-top:26px}
.btn-visit{
  flex:1;padding:11px 16px;
  background:var(--accent);color:#fff;
  border:none;border-radius:7px;
  font-size:.82rem;font-family:'Noto Sans TC',sans-serif;
  cursor:pointer;text-decoration:none;text-align:center;
  letter-spacing:.03em;
  transition:background .2s;
}
.btn-visit:hover{background:#2d4831}
.btn-process{
  flex:1;padding:11px 14px;background:transparent;
  color:var(--accent);border:1px solid var(--accent);
  border-radius:7px;font-size:.82rem;
  font-family:'Noto Sans TC',sans-serif;cursor:pointer;
  text-decoration:none;text-align:center;
  transition:all .2s;white-space:nowrap;
}
.btn-process:hover{background:var(--accent-bg)}
.btn-edit{
  padding:11px 14px;background:transparent;
  color:var(--muted);border:1px solid var(--border);
  border-radius:7px;font-size:.78rem;
  font-family:'Noto Sans TC',sans-serif;cursor:pointer;
  transition:all .2s;white-space:nowrap;
}
.btn-edit:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-bg)}

/* ── Modal ── */
.overlay{
  display:none;position:fixed;inset:0;
  background:rgba(20,20,20,.45);backdrop-filter:blur(4px);
  z-index:200;align-items:center;justify-content:center;
}
.overlay.open{display:flex}
.modal{
  background:#fff;border-radius:18px;
  padding:44px 40px;width:92%;max-width:500px;
  box-shadow:0 24px 72px rgba(0,0,0,.18);
  animation:slideUp .2s ease;
}
@keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.modal-head{margin-bottom:28px}
.modal-head h2{font-family:'Noto Serif TC',serif;font-size:1.25rem;font-weight:400;margin-bottom:4px}
.modal-head p{font-size:.82rem;color:var(--muted)}
.field{margin-bottom:18px}
.field label{display:block;font-size:.76rem;color:var(--muted);letter-spacing:.06em;margin-bottom:7px}
.field input,.field textarea{
  width:100%;padding:10px 14px;
  border:1.5px solid var(--border);border-radius:8px;
  font-size:.88rem;font-family:'Noto Sans TC',sans-serif;
  outline:none;transition:border-color .18s;
  background:#fafaf8;
}
.field input:focus,.field textarea:focus{border-color:var(--accent);background:#fff}
.field textarea{height:130px;resize:vertical}
.modal-btns{display:flex;gap:10px;justify-content:flex-end;margin-top:4px}
.btn-cancel{
  padding:9px 20px;background:transparent;
  border:1px solid var(--border);border-radius:7px;
  cursor:pointer;font-family:'Noto Sans TC',sans-serif;font-size:.84rem;
}
.btn-cancel:hover{background:#f5f5f2}
.btn-save{
  padding:9px 22px;background:var(--accent);color:#fff;
  border:none;border-radius:7px;cursor:pointer;
  font-family:'Noto Sans TC',sans-serif;font-size:.84rem;
  transition:background .2s;
}
.btn-save:hover{background:#2d4831}
.modal-msg{font-size:.82rem;margin-top:12px;text-align:right;min-height:1.2em}
.modal-msg.err{color:#c0392b}
.modal-msg.ok{color:var(--accent)}

/* ── Footer ── */
footer{
  text-align:center;padding:32px 24px;
  font-size:.78rem;color:var(--muted);
  border-top:1px solid var(--border);
  letter-spacing:.04em;
}

@media(max-width:860px){
  .cards{grid-template-columns:repeat(2,1fr)}
  .card{grid-column:auto !important}
}
@media(max-width:540px){
  header{padding:56px 24px 48px}
  main{padding:40px 20px 60px}
  .cards{grid-template-columns:1fr}
  .modal{padding:32px 24px}
}
</style>
</head>
<body>

<header>
  <span class="eyebrow">東海大學光點計畫</span>
  <h1>AI 智慧景觀設計</h1>
  <div class="divider"></div>
  <p class="header-sub">五位研究者運用人工智慧技術，探索景觀設計與環境空間的未來可能</p>
</header>

<main>
  <p class="section-label">研究成果展示 · Research Works</p>
  <div class="cards" id="cards"></div>
</main>

<footer>© 2025 &nbsp;東海大學光點計畫 &nbsp;·&nbsp; AI 智慧景觀設計</footer>

<!-- Modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <div class="modal-head">
      <h2 id="m-title">編輯研究介紹</h2>
      <p id="m-sub"></p>
    </div>
    <div class="field">
      <label>研究介紹</label>
      <textarea id="m-desc" placeholder="簡述你的研究主題、方法與成果（約 80–150 字）"></textarea>
    </div>
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeModal()">取消</button>
      <button class="btn-save" onclick="save()">儲存</button>
    </div>
    <p class="modal-msg" id="m-msg"></p>
  </div>
</div>

<script>
let data=[], cur=null;

async function init(){
  const r=await fetch('data.json?_='+Date.now());
  data=await r.json();
  render();
}

function render(){
  document.getElementById('cards').innerHTML=data.map((s,i)=>`
    <div class="card">
      <div class="card-num">0${i+1} &nbsp;/&nbsp; 0${data.length}</div>
      <div class="card-project">${s.project}</div>
      <div class="card-name">${s.name}</div>
      <div class="card-desc ${s.description?'':'placeholder'}">${s.description||'研究介紹尚未填寫，請點擊右下角「編輯」填入。'}</div>
      <div class="card-actions" style="flex-direction:column;gap:8px">
        <a href="${s.url}" target="_blank" rel="noopener" class="btn-visit">查看研究成果 →</a>
        <div style="display:flex;gap:8px">
          <a href="process.php?i=${i}" class="btn-process">研究過程 ↗</a>
          <button class="btn-edit" onclick="openModal(${i})">編輯介紹</button>
        </div>
      </div>
    </div>`).join('');
}

function openModal(i){
  cur=i;
  const s=data[i];
  document.getElementById('m-title').textContent='編輯：'+s.name;
  document.getElementById('m-sub').textContent=s.project;
  document.getElementById('m-desc').value=s.description||'';
  document.getElementById('m-msg').textContent='';
  document.getElementById('m-msg').className='modal-msg';
  document.getElementById('overlay').classList.add('open');
}

function closeModal(){
  document.getElementById('overlay').classList.remove('open');
  cur=null;
}

async function save(){
  const desc=document.getElementById('m-desc').value.trim();
  const msg=document.getElementById('m-msg');
  if(!desc){msg.textContent='請輸入研究介紹';msg.className='modal-msg err';return}
  msg.textContent='儲存中…';msg.className='modal-msg';
  try{
    const r=await fetch('save.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({index:cur,description:desc})});
    const res=await r.json();
    if(res.success){
      msg.textContent='儲存成功！';msg.className='modal-msg ok';
      data[cur].description=desc;
      render();
      setTimeout(closeModal,900);
    }else{
      msg.textContent=res.error||'密碼錯誤，請再試一次';msg.className='modal-msg err';
    }
  }catch(e){msg.textContent='網路錯誤，請稍後再試';msg.className='modal-msg err'}
}

document.getElementById('overlay').addEventListener('click',e=>{if(e.target===e.currentTarget)closeModal()});
init();
</script>
</body>
</html>
